# Copier vers api/local/.env puis completer (local/.env est ignore par git)
# Port du serveur local EUREX
EUREX_PORT=8787

# URL du Worker Cloudflare (relais IA + entrees /internal/*)
EUREX_WORKER_URL=https://eurex-api.ezzinesalim21.workers.dev

# Secret partagé avec le Worker (variable EUREX_INTERNAL_SECRET du Worker)
EUREX_INTERNAL_SECRET=

# URL du tunnel cloudflared (vide = pas d'annonce au Worker / pas de relais distant)
EUREX_TUNNEL_URL=

# URLs fallback IA (optionnel, identique a la prod)
EUREX_AI_FALLBACK_URLS=

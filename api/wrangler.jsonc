{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eurex-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eurex-db",
      "database_id": "6505a544-f2d2-4010-9f7b-2da31edd9e93"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DOCS_KV",
      "id": "9becacff0b9a4a07ab859e91e4208d92"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}

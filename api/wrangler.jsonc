{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eurex-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eurex-db",
      "database_id": "6505a544-f2d2-4010-9f7b-2da31edd9e93"
    },
    {
      "binding": "COPY_DB",
      "database_name": "eurex-db-copy",
      "database_id": "e6385f73-6d50-4f2a-9b04-b7ebb8dbdf27"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DOCS_KV",
      "id": "9becacff0b9a4a07ab859e91e4208d92"
    }
  ],
  // Chemin Worker -> PostgreSQL via Supabase : le TLS direct est impossible
  // (CA privee Supabase rejetee par Cloudflare), Hyperdrive fait le relais.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6dad0898ae134a2da1ae91acedbb82dc"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // 1er janvier 00:15 UTC : passage automatique au nouvel exercice
  // Chaque jour 00:05 UTC : resync Supabase -> D1 puis retour sur D1
  //   (le quota gratuit D1 se remet a zero a 00:00 UTC)
  // Chaque 6h (11,17,23,05 UTC) : keep-alive Supabase pur (SELECT 1) — la base
  //   gratuite se met en pause apres 7 jours sans activity, le cron journalier
  //   ne suffit plus depuis l'incident de pause ; on le rythme maintenant q6h.
  // Pas de copie vers eurex-db-copy : Supabase tient ce role en continu depuis
  //   2026-10-11 ; l'operation reste disponible a la main via POST /internal/sync-copy
  "triggers": {
    "crons": ["15 0 1 1 *", "5 0 * * *", "11 */6 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}

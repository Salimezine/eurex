{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eurex-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eurex-db",
      "database_id": "6505a544-f2d2-4010-9f7b-2da31edd9e93"
    },
    {
      "binding": "COPY_DB",
      "database_name": "eurex-db-copy",
      "database_id": "e6385f73-6d50-4f2a-9b04-b7ebb8dbdf27"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DOCS_KV",
      "id": "9becacff0b9a4a07ab859e91e4208d92"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // 1er janvier 00:15 UTC : passage automatique au nouvel exercice
  // Tous les jours 02:00 UTC (03:00 TN) : copie de sauvegarde vers eurex-db-copy
  "triggers": {
    "crons": ["15 0 1 1 *", "0 2 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
